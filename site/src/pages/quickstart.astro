---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import InstallCommand from '../components/InstallCommand.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Button from '../components/Button.astro';
import { site, url, docs } from '../data/site';

const sixtySecond = `from apdtflow import APDTFlowForecaster

model = APDTFlowForecaster(forecast_horizon=40, decoder_type='continuous',
                           use_conformal=True)
model.fit(df, target_col='capacity', feature_cols=sensor_cols)

model.predict()                                       # classic grid forecast
model.predict_at(['2026-06-14 14:37', 3.6])           # value at ANY moment
result = model.predict_when(threshold=1.4,            # WHEN it crosses the line
                            direction='below')
result.eta, result.act_by, result.censored
schedule = model.predict_when_fleet(assets,           # whole fleet -> ranked schedule
                                    threshold=1.4, direction='below')`;
const runnable = `import pandas as pd
from apdtflow import APDTFlowForecaster

url = ("https://raw.githubusercontent.com/yotambraun/APDTFlow/main/"
       "dataset_examples/daily-minimum-temperatures-in-me_clean.csv")
df = pd.read_csv(url, parse_dates=["Date"])

model = APDTFlowForecaster(forecast_horizon=14, history_length=30, num_epochs=5,
                           decoder_type="continuous", use_conformal=True)
model.fit(df, target_col="Daily minimum temperatures", date_col="Date")

print(model.predict())                          # next 14 days
print(model.predict_at(["1991-01-01 14:37", 3.6]))  # any moment: timestamp or step offset
r = model.predict_when(threshold=11.0, direction="below", alpha=0.1)  # below 11 °C?
print(r.eta, r.earliest, r.latest, r.act_by, r.censored)  # schedule by act_by`;
---

<BaseLayout
  title="Quickstart"
  description="Install APDTFlow and answer all three forecasting questions in 60 seconds."
>
  <PageHeader
    eyebrow="60-second start"
    title="Quickstart"
    intro="One install, one trained model, three kinds of questions. Continuous-time forecasting with calibrated uncertainty on both value and time."
  />

  <div class="wrap pb-16">
    <div class="max-w-2xl">
      <InstallCommand />
    </div>

    <h2 class="mt-12 text-2xl font-bold tracking-tight">The whole API at a glance</h2>
    <p class="mt-2 max-w-2xl text-muted">
      Two flags unlock the timing capabilities:
      <code class="font-mono text-cyan">decoder_type='continuous'</code> swaps in the
      Neural-ODE decoder you can query at any real-valued time, and
      <code class="font-mono text-cyan">use_conformal=True</code> calibrates the
      uncertainty windows.
    </p>
    <div class="max-w-3xl">
      <CodeBlock code={sixtySecond} />
    </div>

    <h2 class="mt-12 text-2xl font-bold tracking-tight">Run it now</h2>
    <p class="mt-2 max-w-2xl text-muted">
      Real data, about a minute on a laptop CPU. <code class="font-mono text-cyan">censored=True</code>
      is a valid answer ("no crossing within the horizon at this confidence"), and the usual
      one here. <code class="font-mono text-cyan">device='auto'</code>
      (the default) uses a CUDA GPU or Apple MPS when present;
      <a href={docs.gpu} class="text-cyan hover:underline">when a GPU actually helps</a>.
    </p>
    <div class="max-w-3xl">
      <CodeBlock code={runnable} />
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-3">
      <div class="card p-5">
        <code class="font-mono text-sm text-cyan">predict()</code>
        <p class="mt-2 text-sm text-muted">Next k values on the grid, with optional conformal intervals.</p>
      </div>
      <div class="card p-5">
        <code class="font-mono text-sm text-cyan">predict_at(times)</code>
        <p class="mt-2 text-sm text-muted">Value at arbitrary timestamps — fractional steps, beyond the horizon.</p>
      </div>
      <div class="card border-cyan/30 p-5">
        <code class="font-mono text-sm text-cyan">predict_when(threshold)</code>
        <p class="mt-2 text-sm text-muted">A calibrated 90% window on the crossing time, plus an <code class="text-green">act_by</code> edge.</p>
      </div>
    </div>

    <div class="mt-12 rounded-2xl border border-line bg-surface/50 p-6 sm:p-8">
      <h3 class="text-lg font-semibold">Prefer a runnable notebook?</h3>
      <p class="mt-2 text-muted">
        The Quickstart notebook covers all three questions end-to-end and opens in Colab
        with zero setup.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <Button href={site.colab} variant="primary" external>Open in Colab</Button>
        <Button href={url('demos')} variant="secondary">Walk through the demos →</Button>
      </div>
    </div>
  </div>
</BaseLayout>
